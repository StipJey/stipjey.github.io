---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    image?: string;
    imageWidth?: number;
    imageHeight?: number;
    type?: 'website' | 'article';
    publishedTime?: Date;
    modifiedTime?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
    title,
    description,
    image = '/og/home.png',
    imageWidth,
    imageHeight,
    type = 'website',
    publishedTime,
    modifiedTime,
} = Astro.props;
const socialImageURL = new URL(image, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<script is:inline>
    try {
        const savedTheme = localStorage.getItem('site-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
            document.documentElement.dataset.theme = savedTheme;
        }
    } catch (_) {
        // Storage may be unavailable; the CSS media query still follows the system.
    }
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
    href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Unbounded:wght@200..900&display=swap"
    rel="stylesheet"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
{(imageWidth || image === '/og/home.png') && <meta property="og:image:width" content={imageWidth ?? 1200} />}
{(imageHeight || image === '/og/home.png') && <meta property="og:image:height" content={imageHeight ?? 630} />}
<meta property="og:locale" content="ru_RU" />
<meta property="og:site_name" content="Евгений Черкасов" />
{
    publishedTime && (
        <meta
            property="article:published_time"
            content={publishedTime.toISOString()}
        />
    )
}
{
    modifiedTime && (
        <meta
            property="article:modified_time"
            content={modifiedTime.toISOString()}
        />
    )
}
{
    type === 'article' && (
        <meta property="article:author" content="Евгений Черкасов" />
    )
}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />

<!-- Telegram -->
<meta property="telegram:channel" content="@frontend_lead_mentor" />

<!-- SEO -->
<meta
    name="google-site-verification"
    content="-uqPE_RueDQF0Ic__kcjj6eOeEZ6ul9baD9zpo_maM8"
/>
<meta name="yandex-verification" content="385e9e757fa09ce7" />

<!-- Yandex.Metrika counter -->
<script type="text/javascript" is:inline>
    (function (m, e, t, r, i, k, a) {
        m[i] =
            m[i] ||
            function () {
                (m[i].a = m[i].a || []).push(arguments);
            };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
            if (document.scripts[j].src === r) {
                return;
            }
        }
        ((k = e.createElement(t)),
            (a = e.getElementsByTagName(t)[0]),
            (k.async = 1),
            (k.src = r),
            a.parentNode.insertBefore(k, a));
    })(
        window,
        document,
        'script',
        'https://mc.yandex.ru/metrika/tag.js?id=106572860',
        'ym'
    );

    ym(106572860, 'init', {
        ssr: true,
        webvisor: true,
        clickmap: true,
        ecommerce: 'dataLayer',
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true,
    });

    document.addEventListener('click', (event) => {
        const target = event.target;
        const link = target instanceof Element ? target.closest('a[data-goal]') : null;
        const goal = link && link.getAttribute('data-goal');
        if ((goal === 'telegram' || goal === 'resume') && typeof window.ym === 'function') {
            window.ym(106572860, 'reachGoal', goal);
        }
    });
</script>
<!-- /Yandex.Metrika counter -->
