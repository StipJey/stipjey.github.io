---
const telegram = 'https://t.me/stipjey';
---

<noscript><div><img src="https://mc.yandex.ru/watch/106572860" style="position:absolute;left:-9999px" alt="" /></div></noscript>
<header class="site-header">
    <nav class="site-nav" aria-label="Основная навигация">
        <a class="identity" href="/" aria-label="Евгений Черкасов — главная">
            <span class="monogram" aria-hidden="true">ЕЧ</span>
            <span class="identity-copy"><strong>Евгений Черкасов</strong><small>StipJey · Head of Frontend</small></span>
        </a>
        <div class="nav-links">
            <a href="/#experience">Опыт</a>
            <a href="/#projects">Проекты</a>
            <a href="/#consulting">Консультации</a>
            <a href="/#blog">Блог</a>
        </div>
        <div class="nav-actions">
            <label class="theme-control">
                <span>Тема</span>
                <select id="site-theme" aria-label="Тема оформления">
                    <option value="auto">Авто</option>
                    <option value="light">Светлая</option>
                    <option value="dark">Тёмная</option>
                </select>
            </label>
            <a class="contact-link" href={telegram} target="_blank" rel="noopener noreferrer" data-goal="telegram">Связаться <span aria-hidden="true">↗</span></a>
        </div>
    </nav>
</header>
<script is:inline>
    (() => {
        const select = document.getElementById('site-theme');
        if (!(select instanceof HTMLSelectElement)) return;
        select.value = document.documentElement.dataset.theme || 'auto';
        select.addEventListener('change', () => {
            const choice = select.value;
            if (choice === 'light' || choice === 'dark') {
                document.documentElement.dataset.theme = choice;
            } else {
                delete document.documentElement.dataset.theme;
            }
            try {
                if (choice === 'auto') localStorage.removeItem('site-theme');
                else localStorage.setItem('site-theme', choice);
            } catch (_) {
                // The selected mode still works for this page when storage is blocked.
            }
        });
    })();
</script>
<style>
    .site-header {
        position: relative;
        z-index: 10;
        padding: 0 clamp(1rem, 3vw, 2.5rem);
        background: var(--surface);
        border-bottom: 1px solid var(--line);
    }
    .site-nav {
        max-width: 1440px;
        min-height: 82px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }
    .identity, .nav-links a, .contact-link { text-decoration: none; }
    .identity {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: .75rem;
        color: var(--text-primary);
    }
    .identity:hover { color: var(--text-primary); }
    .monogram {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #172235;
        color: #fff;
        font: 700 .86rem/1 'Unbounded', sans-serif;
        letter-spacing: -.07em;
    }
    .identity-copy { display: grid; gap: .1rem; line-height: 1.2; }
    .identity-copy strong { font-size: .83rem; }
    .identity-copy small { color: var(--text-muted); font-size: .64rem; }
    .nav-links, .nav-actions { display: flex; align-items: center; gap: clamp(.55rem, 1.4vw, 1.5rem); }
    .nav-links a { color: var(--text-primary); font-size: .77rem; font-weight: 600; white-space: nowrap; }
    .nav-links a:hover { color: var(--brand); }
    .theme-control { display: flex; align-items: center; gap: .45rem; color: var(--text-muted); font-size: .7rem; white-space: nowrap; }
    .theme-control select {
        max-width: 7.2rem;
        padding: .52rem .42rem;
        border: 1px solid var(--line);
        border-radius: 9px;
        color: var(--text-primary);
        background: var(--surface-raised);
        font: inherit;
        cursor: pointer;
    }
    .contact-link {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        padding: .7rem 1rem;
        border-radius: 10px;
        background: var(--brand);
        color: var(--on-accent);
        font-size: .73rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .contact-link:hover { background: var(--accent-dark); color: var(--on-accent); }
    @media (max-width: 980px) {
        .site-nav { flex-wrap: wrap; gap: .5rem; padding: .7rem 0; }
        .identity { order: 1; }
        .nav-actions { order: 2; margin-left: auto; }
        .nav-links { order: 3; width: 100%; justify-content: space-between; overflow-x: auto; padding: .35rem 0 .15rem; }
    }
    @media (max-width: 520px) {
        .site-nav { min-height: 0; }
        .identity-copy small { display: none; }
        .identity-copy strong { font-size: .72rem; }
        .monogram { width: 36px; height: 36px; font-size: .7rem; }
        .theme-control { gap: 0; }
        .theme-control span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
        .theme-control select { max-width: 6.8rem; padding: .46rem .3rem; }
        .contact-link { padding: .57rem .7rem; }
        .nav-links { gap: .8rem; }
        .nav-links a { font-size: .72rem; }
    }
    @media (max-width: 370px) {
        .identity-copy { display: none; }
        .contact-link { font-size: .66rem; }
    }
    @media (prefers-reduced-motion: no-preference) {
        .nav-links a, .contact-link { transition: color 180ms ease, background-color 180ms ease; }
    }
</style>
