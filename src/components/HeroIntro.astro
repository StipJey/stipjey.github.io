---
interface Props {
    tone?: 'blue' | 'warm';
}

const { tone = 'blue' } = Astro.props;
---

<canvas class="hero-intro" data-tone={tone} aria-hidden="true"></canvas>

<style>
    .hero-intro {
        position: absolute;
        z-index: -1;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    @media (forced-colors: active) {
        .hero-intro { display: none; }
    }
</style>

<script>
    document.querySelectorAll<HTMLCanvasElement>('.hero-intro').forEach(drawIntro);

    function drawIntro(canvas: HTMLCanvasElement) {
        const gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: false });
        if (!gl) return;

        const vertex = compile(gl, gl.VERTEX_SHADER, `
            attribute vec2 position;
            varying vec2 uv;

            void main() {
                uv = position * 0.5 + 0.5;
                gl_Position = vec4(position, 0.0, 1.0);
            }
        `);
        const fragment = compile(gl, gl.FRAGMENT_SHADER, `
            precision mediump float;
            varying vec2 uv;
            uniform float time;
            uniform float warm;

            void main() {
                vec2 p = uv;
                if (warm > 0.5) {
                    vec2 center = vec2(0.85 + 0.12 * cos(time), 0.50 + 0.24 * sin(time));
                    vec2 haloCenter = vec2(1.03, 0.25 + 0.25 * cos(time));
                    vec2 near = (p - center) * vec2(3.5, 2.6);
                    vec2 far = (p - haloCenter) * vec2(2.5, 2.1);
                    float light = exp(-dot(near, near) * 2.4);
                    float halo = exp(-dot(far, far) * 1.7);
                    float mask = smoothstep(0.30, 1.0, p.x);
                    vec3 tint = mix(vec3(0.25, 0.32, 0.17), vec3(0.76, 0.86, 0.40), light);
                    gl_FragColor = vec4(tint, mask * (0.28 * light + 0.23 * halo));
                    return;
                }

                float drift = sin(p.x * 5.0 - time) * 0.18;
                float ribbon = p.y - 0.67 + drift + (p.x - 0.7) * 0.42;
                float fold = sin(p.x * 9.0 + p.y * 5.0 - time);
                float threads = pow(0.5 + 0.5 * cos(ribbon * 78.0 + fold * 2.8), 6.0);
                float sheen = exp(-abs(ribbon) * 6.0);
                float field = exp(-length((p - vec2(0.87, 0.73)) * vec2(2.4, 2.3)) * 2.2);
                float edge = smoothstep(0.25, 1.0, p.x) * smoothstep(0.03, 0.35, p.y);
                float glow = edge * (field * 0.32 + sheen * (0.13 + threads * 0.24));
                vec3 blue = mix(vec3(0.10, 0.35, 0.83), vec3(0.37, 0.66, 1.0), threads);
                gl_FragColor = vec4(blue, glow);
            }
        `);
        if (!vertex || !fragment) return;

        const program = gl.createProgram();
        if (!program) return;
        gl.attachShader(program, vertex);
        gl.attachShader(program, fragment);
        gl.linkProgram(program);
        gl.deleteShader(vertex);
        gl.deleteShader(fragment);
        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;

        const buffer = gl.createBuffer();
        if (!buffer) return;
        const position = gl.getAttribLocation(program, 'position');
        const time = gl.getUniformLocation(program, 'time');
        gl.useProgram(program);
        gl.uniform1f(gl.getUniformLocation(program, 'warm'), canvas.dataset.tone === 'warm' ? 1 : 0);
        gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        gl.enableVertexAttribArray(position);
        gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

        const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const introDuration = 2600;
        const introEnd = 2.1;
        const loopSpeed = 0.0011 / 3;
        const cycle = 2 * Math.PI;
        let frame = 0;
        let phase = motion.matches ? introEnd : 0;
        let introFinished = motion.matches;
        let previousFrame = 0;
        let introElapsed = 0;
        let visible = !('IntersectionObserver' in window);

        function render() {
            if (!gl) return;
            gl.uniform1f(time, phase);
            gl.drawArrays(gl.TRIANGLES, 0, 3);
        }

        function resize() {
            if (!gl) return;
            const { width, height } = canvas.getBoundingClientRect();
            if (!width || !height) return;
            const scale = Math.min(window.devicePixelRatio, 900 / width, 1.5);
            canvas.width = Math.round(width * scale);
            canvas.height = Math.round(height * scale);
            gl.viewport(0, 0, canvas.width, canvas.height);
            render();
        }

        function scheduleFrame() {
            if (!frame && visible && !motion.matches && !gl?.isContextLost()) {
                frame = requestAnimationFrame(tick);
            }
        }

        function tick(now: number) {
            frame = 0;
            const elapsed = previousFrame ? Math.min(32, now - previousFrame) : 0;
            if (!introFinished) {
                introElapsed += elapsed;
                const progress = Math.min(1, introElapsed / introDuration);
                const remaining = 1 - progress;
                // Ease out the extra speed while the loop pace stays constant.
                phase = introElapsed * loopSpeed
                    + (introEnd - introDuration * loopSpeed) * (1 - remaining ** 5);
                introFinished = progress === 1;
            } else {
                phase = (phase + elapsed * loopSpeed) % cycle;
            }
            render();

            previousFrame = now;
            scheduleFrame();
        }

        const resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(canvas);
        const visibilityObserver = visible ? undefined : new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            if (visible) {
                scheduleFrame();
            } else {
                cancelAnimationFrame(frame);
                frame = 0;
                previousFrame = 0;
            }
        });
        visibilityObserver?.observe(canvas);
        if (!introFinished) scheduleFrame();

        motion.addEventListener('change', () => {
            if (!motion.matches) {
                scheduleFrame();
                return;
            }
            cancelAnimationFrame(frame);
            frame = 0;
            previousFrame = 0;
            introFinished = true;
            phase = introEnd;
            render();
        });

        canvas.addEventListener('webglcontextlost', () => {
            cancelAnimationFrame(frame);
            frame = 0;
            resizeObserver.disconnect();
            visibilityObserver?.disconnect();
            canvas.hidden = true;
        }, { once: true });
    }

    function compile(gl: WebGLRenderingContext, type: number, source: string) {
        const shader = gl.createShader(type);
        if (!shader) return null;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (gl.getShaderParameter(shader, gl.COMPILE_STATUS)) return shader;
        gl.deleteShader(shader);
        return null;
    }
</script>
