---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	seoTitle,
	ogTitle,
	ogDescription,
	ogImage,
	pubDate,
	updatedDate,
	heroImage,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	author: {
		'@type': 'Person',
		name: 'Евгений Черкасов',
	},
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalURL,
	},
	publisher: {
		'@type': 'Person',
		name: 'Евгений Черкасов',
	},
	...(heroImage && {
		image: new URL(heroImage.src, Astro.site).href,
	}),
};
const blogPostingJsonLd = JSON.stringify(blogPostingSchema).replace(/</g, '\\u003c');
---

<html lang="ru">
	<head>
		<BaseHead
			title={title}
			description={description}
			seoTitle={seoTitle}
			ogTitle={ogTitle}
			ogDescription={ogDescription}
			ogImage={ogImage}
			image={heroImage?.src}
			imageWidth={heroImage?.width}
			imageHeight={heroImage?.height}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
		<script type="application/ld+json" set:html={blogPostingJsonLd} />
		<style>
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				margin: auto;
				padding: 1em 0;
				color: var(--text);
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--muted);
			}
			.last-updated-on {
				font-style: italic;
			}
			:global(.formula-table-wrap) {
				width: 100%;
				max-width: 100%;
				margin: 1.5em 0;
			}
			:global(.formula-table-wrap) :global(table) {
				width: 100%;
				max-width: 100%;
				display: table;
				white-space: normal;
				border-collapse: collapse;
				table-layout: fixed;
			}
			:global(.formula-table-wrap) :global(caption) {
				padding: 0.5rem;
				text-align: left;
				font-weight: 600;
			}
			:global(.formula-table-wrap) :global(th),
			:global(.formula-table-wrap) :global(td) {
				padding: 0.75rem;
				border: 1px solid var(--muted);
				vertical-align: top;
				text-align: left;
				overflow-wrap: anywhere;
			}
			:global(.formula-table-wrap) :global(thead th:first-child) {
				width: 26%;
			}
			:global(.formula-table-wrap) :global(details) {
				margin-top: 0.75rem;
			}
			:global(.formula-table-wrap) :global(summary) {
				cursor: pointer;
			}
			@media (max-width: 40rem) {
				:global(.formula-table-wrap) :global(thead th:first-child) {
					width: 40%;
				}
				:global(.formula-table-wrap) :global(th),
				:global(.formula-table-wrap) :global(td) {
					padding: 0.375rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{
						heroImage && (
							<img
								width={heroImage.width}
								height={heroImage.height}
								src={heroImage.src}
								alt=""
							/>
						)
					}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Обновлено{' '}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
