---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TelegramIcon from '../components/TelegramIcon.astro';
import { getCollection } from 'astro:content';
import '../styles/home.css';

const telegram = 'https://t.me/stipjey';
const channel = 'https://t.me/+fcLS-3M_XSYxMDVi';
const resume =
    'https://spb.hh.ru/resume/0de0d9a4ff07ef1aa60039ed1f3266446e4855';
const personSchema = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Евгений Черкасов',
    alternateName: 'Evgeny Cherkasov',
    url: 'https://stipjey.github.io/',
    jobTitle: 'Head of Frontend Development',
    description: 'Руководитель frontend-разработки. Развиваю архитектуру, команды и инженерные процессы.',
    sameAs: ['https://github.com/StipJey', telegram, resume],
};
const selectedPosts = [
    'ssr-ssg-spa',
    'type-vs-interface',
    'short-consultation',
];
const posts = (await getCollection('blog'))
    .filter((post) => selectedPosts.includes(post.id))
    .sort((a, b) => selectedPosts.indexOf(a.id) - selectedPosts.indexOf(b.id));
const services = [
    {
        number: '01',
        icon: '</>',
        className: 'lime',
        title: 'Разобрать frontend и архитектуру',
        description: 'Найти узкие места, снизить сложность и дать команде ясный технический план.',
        examples: ['Аудит кодовой базы и процессов', 'Архитектурные решения и миграции', 'Производительность и качество'],
        outcome: 'Понятный путь улучшений и меньше технических рисков.',
    },
    {
        number: '02',
        icon: '◎',
        className: 'blue',
        title: 'Развить команду',
        description: 'Выстроить найм, онбординг и инженерные практики без лишней бюрократии.',
        examples: ['Найм и оценка разработчиков', 'Онбординг и развитие', 'Ревью и инженерные процессы'],
        outcome: 'Самостоятельная команда с предсказуемой работой.',
    },
    {
        number: '03',
        icon: '✳',
        className: 'violet',
        title: 'Применить AI с пользой',
        description: 'Найти задачи, где AI помогает продукту и разработке, и проверить идеи на практике.',
        examples: ['AI в пользовательских сценариях', 'Рабочие процессы команды', 'Прототипы и оценка ограничений'],
        outcome: 'Проверенные сценарии для продукта и команды.',
    },
];
const cases = [
    {
        label: 'КОМАНДА',
        value: '2 недели',
        title: 'Новый разработчик быстрее входит в работу',
        problem: 'Долгий онбординг замедлял команду и мешал новичкам стать самостоятельными.',
        action: 'Собрал базу знаний для онбординга фронтенд-разработчиков.',
        result: 'Срок выхода на самостоятельную работу сократился с двух месяцев до двух недель.',
        color: 'mint',
    },
    {
        label: 'ПРОЦЕССЫ',
        value: '≈ ×2',
        title: 'Быстрее вёрстка и интеграция',
        problem: 'Прежняя система статической вёрстки усложняла создание новых интерфейсов.',
        action: 'Создал новую систему статической вёрстки взамен прежней.',
        result: 'Время вёрстки и интеграции сократилось примерно вдвое.',
        color: 'sky',
    },
    {
        label: 'НАЙМ',
        value: '10+ наймов',
        title: 'Разработчики остаются в команде',
        problem: 'Нужно было находить разработчиков, подходящих под задачи команды.',
        action: 'Выстроил процесс найма, провёл около 50 собеседований и сделал 15 офферов. 11 человек приняли предложение.',
        result: 'Все 11 прошли испытательный срок. Шесть человек работают в команде более двух лет.',
        color: 'lilac',
    },
];
---

<!doctype html>
<html lang="ru">
    <head>
        <BaseHead
            title="Евгений Черкасов — Head of Frontend Development"
            description="Евгений Черкасов — Head of Frontend Development. Развиваю frontend, команды и процессы. Открыт к предложениям."
            image="/og/home.png"
        />
        <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    </head>
    <body class="home-page">
        <Header />
        <main class="home" id="top">
            <div class="hero-grid" aria-label="Обо мне">
                <section class="tile hero" data-entrance>
                    <div class="hero-topline">
                        <span class="availability"><span class="availability-dot"></span> Открыт к предложениям</span>
                        <span class="location">Санкт-Петербург / remote</span>
                    </div>
                    <div>
                        <p class="eyebrow">Евгений Черкасов · Head of Frontend Development</p>
                        <h1>Развиваю <em>frontend</em>, команды и процессы.</h1>
                        <p class="hero-lead">Руковожу frontend-разработкой программы лояльности крупного банка. Развиваю архитектуру, команды и процессы, применяю AI в продукте и работе команды.</p>
                        <div class="hero-actions">
                            <a class="button button-primary" href={telegram} target="_blank" rel="noopener noreferrer" data-goal="telegram"><TelegramIcon /> Написать в Telegram</a>
                            <a class="button button-secondary" href={resume} target="_blank" rel="noopener noreferrer" data-goal="resume">Смотреть резюме <span aria-hidden="true">✦</span></a>
                        </div>
                    </div>
                </section>
                <section class="tile proof" id="experience" aria-label="Опыт и результаты" data-entrance>
                    <div class="proof-item"><strong>50+</strong><span>интервью<br /><small>провёл с кандидатами</small></span></div>
                    <div class="proof-item"><strong>10+</strong><span>успешных наймов<br /><small>11 принятых офферов из 15</small></span></div>
                    <div class="proof-item"><strong>2 недели</strong><span>до работы без помощи<br /><small>раньше — 2 месяца</small></span></div>
                    <div class="proof-item"><strong>≈ ×2</strong><span>быстрее вёрстка и интеграция<br /><small>после обновления системы вёрстки</small></span></div>
                </section>
                <a class="tile philosophy" href={channel} target="_blank" rel="noopener noreferrer" aria-label="Читать Telegram-канал: Заметки о работе" data-entrance>
                    <span class="card-kicker">Telegram-канал</span>
                    <h2>Заметки о работе</h2>
                    <span class="telegram-orbit"><TelegramIcon /></span>
                    <p>Пишу про frontend, управление командой и AI. <strong>2,5 тыс.+</strong> читателей.</p>
                    <span class="channel-link">Читать канал <span aria-hidden="true">✦</span></span>
                </a>
                <aside class="tile expertise" data-entrance>
                    <span class="card-kicker">Мой стек и экспертиза</span>
                    <h2>От задачи до решения</h2>
                    <div class="chips"><span>React</span><span>TypeScript</span><span>Архитектура</span><span>Performance</span><span>Team Leadership</span><span>AI / SDLC</span></div>
                </aside>
                <aside class="tile process" data-entrance>
                    <span class="card-kicker">Как работаю</span>
                    <p class="process-statement">Разобраться.<br />Проверить.<br />Сделать.</p>
                    <span class="process-caption">От задачи к результату</span>
                </aside>
            </div>

            <section class="home-section" id="help">
                <div class="section-heading"><div><p class="section-index">01 / Направления</p><h2>Чем могу быть полезен</h2><p>Технические задачи, развитие команды и применение AI.</p></div></div>
                <div class="service-grid">
                    {services.map((service) => (
                        <details class={`tile service-card ${service.className}`}>
                            <summary><span class="service-icon" aria-hidden="true">{service.icon}</span><span class="service-number">{service.number}</span><h3>{service.title}</h3><p>{service.description}</p><span class="service-outcome"><span aria-hidden="true">✦</span> {service.outcome}</span><span class="expand-hint">Примеры задач <span aria-hidden="true">＋</span></span></summary>
                            <div class="service-details"><ul>{service.examples.map((example) => <li>{example}</li>)}</ul><a href={telegram} target="_blank" rel="noopener noreferrer" data-goal="telegram">Обсудить задачу <span aria-hidden="true">✦</span></a></div>
                        </details>
                    ))}
                </div>
            </section>

            <section class="home-section" id="results">
                <div class="section-heading"><div><p class="section-index">02 / Результаты</p><h2>Результаты работы</h2><p>Задачи, решения и измеримые изменения.</p></div></div>
                <div class="case-grid">
                    {cases.map((item, index) => (
                        <details class={`tile case-card ${item.color}`}>
                            <summary><span class="case-top"><span class="case-label">{item.label}</span><span class="case-index">0{index + 1}</span></span><strong class="case-value">{item.value}</strong><h3>{item.title}</h3><span class="case-open">Подробнее <span aria-hidden="true">＋</span></span></summary>
                            <div class="case-details"><dl><dt>Задача</dt><dd>{item.problem}</dd><dt>Что сделал</dt><dd>{item.action}</dd><dt>Результат</dt><dd>{item.result}</dd></dl></div>
                        </details>
                    ))}
                </div>
                <a class="text-link" href={resume} target="_blank" rel="noopener noreferrer" data-goal="resume">Больше об опыте — в резюме <span aria-hidden="true">✦</span></a>
            </section>

            <section class="home-section" id="projects">
                <div class="section-heading"><div><p class="section-index">03 / Сайд-проекты</p><h2>Мои проекты</h2><p>Сайд-проекты, в которых проверяю идеи на практике.</p></div></div>
                <div class="project-grid">
                    <a class="tile project-card project-clicker" href="/tools/clicker/"><span class="project-art" aria-hidden="true">⌖</span><span class="project-type">Веб · эксперимент</span><h3>Clicker</h3><p>Счётчик кликов с историей. Эксперимент с обратной связью и простым интерфейсом.</p><span class="project-action">Открыть проект <span aria-hidden="true">✦</span></span></a>
                    <a class="tile project-card project-breeze" href="/tools/breeze/"><span class="project-art" aria-hidden="true">≈</span><span class="project-type">Веб · инструмент</span><h3>Breeze</h3><p>Небольшой инструмент для концентрации и спокойной работы.</p><span class="project-action">Открыть проект <span aria-hidden="true">✦</span></span></a>
                    <a class="tile project-card project-keyboard" href="/blog/stipjey-keyboard-layout/"><span class="project-art" aria-hidden="true">⌘</span><span class="project-type">Идея · статья</span><h3>Раскладка клавиатуры</h3><p>Как я сделал собственную раскладку клавиатуры для повседневной работы.</p><span class="project-action">Читать историю <span aria-hidden="true">✦</span></span></a>
                </div>
            </section>

            <div class="lower-grid">
                <section class="tile consulting" id="consulting"><p class="section-index">04 / Консультации</p><h2>Помогу разобраться с технической задачей.</h2><p>Архитектура и технические решения, развитие команды, AI в продукте и разработке. Расскажите о задаче — вместе определим подходящий формат.</p><ul><li>Разбор конкретной ситуации</li><li>Аудит и рекомендации</li><li>Сопровождение изменений</li></ul><a class="button button-lime" href={telegram} target="_blank" rel="noopener noreferrer" data-goal="telegram"><TelegramIcon /> Написать о задаче</a><small>Формат и стоимость обсуждаем индивидуально.</small></section>
                <section class="home-section blog-section" id="blog"><div class="section-heading"><div><p class="section-index">05 / Пишу о практике</p><h2>Блог</h2><p>Заметки о разработке и управлении командой.</p></div><a class="text-link" href="/blog/">Все статьи <span aria-hidden="true">✦</span></a></div><div class="post-grid">{posts.map((post) => <a class="tile post-card" href={`/blog/${post.id}/`}><span class="post-label">{post.id === 'short-consultation' ? 'КОНСАЛТИНГ' : 'ТЕХНОЛОГИИ'}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="post-arrow" aria-hidden="true">✦</span></a>)}</div></section>
            </div>
            <section class="closing" aria-label="Связаться"><span class="section-index">На связи</span><h2>Открыт к предложениям и новым проектам. Напишите, если мой опыт может быть полезен.</h2><div class="closing-actions"><a class="button button-primary" href={telegram} target="_blank" rel="noopener noreferrer" data-goal="telegram"><TelegramIcon /> Написать в Telegram</a><a class="button button-dark-outline" href={resume} target="_blank" rel="noopener noreferrer" data-goal="resume">Резюме на HH <span aria-hidden="true">✦</span></a><a class="button button-dark-outline" href="https://github.com/StipJey" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">✦</span></a></div><div class="closing-meta"><span>Евгений Черкасов</span><span>Санкт-Петербург / remote</span></div></section>
        </main>
        <Footer />
        <script>
            import { animate, stagger } from 'animejs';

            const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
            if (!motion.matches) {
                animate('.home [data-entrance]', {
                    opacity: [0, 1],
                    translateY: [16, 0],
                    delay: stagger(65),
                    duration: 530,
                    ease: 'out(3)',
                });
            }

            const multiColumnCards = window.matchMedia('(min-width: 851px)');
            const expandableGrids = document.querySelectorAll(
                '.service-grid, .case-grid',
            );

            for (const grid of expandableGrids) {
                grid.addEventListener('click', (event) => {
                    if (!(event.target instanceof Element)) return;

                    const summary = event.target.closest('summary');
                    const selectedCard = summary?.parentElement;
                    if (
                        !multiColumnCards.matches ||
                        !(selectedCard instanceof HTMLDetailsElement) ||
                        !grid.contains(selectedCard)
                    ) {
                        return;
                    }

                    event.preventDefault();
                    const shouldOpen = !selectedCard.open;
                    grid.querySelectorAll('details').forEach((card) => {
                        card.open = shouldOpen;
                    });
                });
            }

            multiColumnCards.addEventListener('change', (event) => {
                if (!event.matches) return;

                for (const grid of expandableGrids) {
                    const shouldOpen = Array.from(grid.querySelectorAll('details')).some(
                        (card) => card.open,
                    );
                    grid.querySelectorAll('details').forEach((card) => {
                        card.open = shouldOpen;
                    });
                }
            });

        </script>
    </body>
</html>
