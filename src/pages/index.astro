---
import BaseHead from '../components/BaseHead.astro';
import HeroIntro from '../components/HeroIntro.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TelegramIcon from '../components/TelegramIcon.astro';
import { getCollection } from 'astro:content';
import '../styles/home.css';

const telegram = 'https://t.me/stipjey';
const channel = 'https://t.me/+fcLS-3M_XSYxMDVi';
const resume =
    'https://spb.hh.ru/resume/0de0d9a4ff07ef1aa60039ed1f3266446e4855';
const personSchema = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Евгений Черкасов',
    alternateName: 'Evgeny Cherkasov',
    url: 'https://stipjey.github.io/',
    jobTitle: 'Head of Frontend Development',
    description: 'Руководитель frontend-разработки. Развиваю архитектуру, команды и инженерные процессы.',
    sameAs: ['https://github.com/StipJey', telegram, resume],
};
const selectedPosts = [
    'ssr-ssg-spa',
    'type-vs-interface',
    'sobesedovanie-na-timlida',
];
const posts = (await getCollection('blog'))
    .filter((post) => selectedPosts.includes(post.id))
    .sort((a, b) => selectedPosts.indexOf(a.id) - selectedPosts.indexOf(b.id));
const services = [
    {
        number: '01',
        icon: '</>',
        className: 'lime',
        title: 'Разобрать frontend и архитектуру',
        description: 'Найти узкие места, снизить сложность и дать команде ясный технический план.',
        examples: ['Аудит кодовой базы и процессов', 'Архитектурные решения и миграции', 'Производительность и качество'],
        outcome: 'Понятный путь улучшений и меньше технических рисков.',
    },
    {
        number: '02',
        icon: '◎',
        className: 'blue',
        title: 'Развить команду',
        description: 'Выстроить найм, онбординг и инженерные практики без лишней бюрократии.',
        examples: ['Найм и оценка разработчиков', 'Онбординг и развитие', 'Ревью и инженерные процессы'],
        outcome: 'Самостоятельная команда с предсказуемой работой.',
    },
    {
        number: '03',
        icon: '✳',
        className: 'violet',
        title: 'Применить AI с пользой',
        description: 'Найти задачи, где AI помогает продукту и разработке, и проверить идеи на практике.',
        examples: ['AI в пользовательских сценариях', 'Рабочие процессы команды', 'Прототипы и оценка ограничений'],
        outcome: 'Проверенные сценарии для продукта и команды.',
    },
];
const cases = [
    {
        label: 'КОМАНДА',
        value: '2 недели',
        title: 'Новый разработчик быстрее входит в работу',
        problem: 'Долгий онбординг замедлял команду и мешал новичкам стать самостоятельными.',
        action: 'Собрал базу знаний для онбординга фронтенд-разработчиков.',
        result: 'Срок выхода на самостоятельную работу сократился с двух месяцев до двух недель.',
        color: 'mint',
    },
    {
        label: 'ПРОЦЕССЫ',
        value: '≈ 2×',
        title: 'Быстрее вёрстка и интеграция',
        problem: 'Прежняя система статической вёрстки усложняла создание новых интерфейсов.',
        action: 'Создал новую систему статической вёрстки взамен прежней.',
        result: 'Время вёрстки и интеграции сократилось примерно вдвое.',
        color: 'sky',
    },
    {
        label: 'НАЙМ',
        value: '10+ наймов',
        title: 'Разработчики остаются в команде',
        problem: 'Нужно было находить разработчиков, подходящих под задачи команды.',
        action: 'Выстроил процесс найма, провёл около 50 собеседований и сделал 15 офферов. 11 человек приняли предложение.',
        result: 'Все 11 прошли испытательный срок. Шесть человек работают в команде более двух лет.',
        color: 'lilac',
    },
];
---

<!doctype html>
<html lang="ru">
    <head>
        <BaseHead
            title="Евгений Черкасов — Head of Frontend Development"
            description="Евгений Черкасов — Head of Frontend Development. Развиваю frontend, команды и процессы. Открыт к предложениям."
            image="/og/home.png"
        />
        <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    </head>
    <body class="home-page">
        <a class="skip-link" href="#top">К основному содержанию</a>
        <Header />
        <main class="home" id="top" tabindex="-1">
            <div class="hero-grid" aria-label="Обо мне">
                <section class="tile hero">
                    <HeroIntro />
                    <div class="hero-topline">
                        <span class="availability"><span class="availability-dot"></span> Открыт к предложениям</span>
                        <span class="location">Санкт-Петербург · Удалённо</span>
                    </div>
                    <div class="hero-copy">
                        <p class="eyebrow">Евгений Черкасов · Head of Frontend Development</p>
                        <h1>Развиваю <em>frontend</em>, команды и процессы.</h1>
                        <p class="hero-lead">Руковожу frontend-разработкой программы лояльности крупного банка. Развиваю архитектуру, команды и процессы, применяю AI в продукте и работе команды.</p>
                        <div class="hero-actions">
                            <a class="button button-primary" href={telegram} target="_blank" rel="noopener noreferrer" data-goal="telegram"><TelegramIcon /> Написать в Telegram</a>
                            <a class="button button-secondary" href={resume} target="_blank" rel="noopener noreferrer" data-goal="resume">Смотреть резюме</a>
                        </div>
                    </div>
                </section>
                <section class="tile proof" id="experience" aria-label="Опыт и результаты">
                    <div class="proof-item"><strong>≈ 50</strong><span>интервью<br /><small>провёл с кандидатами</small></span></div>
                    <div class="proof-item"><strong>10+</strong><span>успешных наймов<br /><small>11 прошли испытательный срок</small></span></div>
                    <div class="proof-item"><strong>2 недели</strong><span>до самостоятельной работы<br /><small>раньше — 2 месяца</small></span></div>
                    <div class="proof-item"><strong>≈ 2×</strong><span>быстрее вёрстка и интеграция<br /><small>после обновления системы вёрстки</small></span></div>
                </section>
                <a class="tile philosophy" href={channel} target="_blank" rel="noopener noreferrer" aria-label="Читать Telegram-канал: Заметки о работе">
                    <span class="card-kicker">Telegram-канал</span>
                    <h2>Заметки о работе</h2>
                    <span class="telegram-orbit"><TelegramIcon /></span>
                    <p>Пишу про frontend, управление командой и AI.</p>
                    <p class="channel-readers"><strong>2,5&nbsp;тыс.+</strong>&nbsp;читателей</p>
                    <span class="channel-link">Читать канал</span>
                </a>
                <aside class="tile expertise">
                    <h2>Стек и экспертиза</h2>
                    <div class="chips"><span>React</span><span>TypeScript</span><span>Архитектура</span><span>Performance</span><span>Team Leadership</span><span>AI / SDLC</span></div>
                </aside>
            </div>

            <section class="home-section" id="help">
                <div class="section-heading"><div><p class="section-index">01 / Направления</p><h2>Чем могу быть полезен</h2></div></div>
                <div class="service-grid">
                    {services.map((service) => (
                        <details class={`tile service-card ${service.className}`}>
                            <summary><span class="service-icon" aria-hidden="true">{service.icon}</span><span class="service-number">{service.number}</span><h3>{service.title}</h3><p>{service.description}</p><span class="service-outcome">{service.outcome}</span><span class="expand-hint">Примеры задач <span aria-hidden="true">＋</span></span></summary>
                            <div class="service-details"><ul>{service.examples.map((example) => <li>{example}</li>)}</ul><a href={telegram} target="_blank" rel="noopener noreferrer" data-goal="telegram">Обсудить задачу</a></div>
                        </details>
                    ))}
                </div>
            </section>

            <section class="home-section" id="results">
                <div class="section-heading"><div><p class="section-index">02 / Результаты</p><h2>Результаты работы</h2><p>Задачи, решения и измеримые изменения.</p></div></div>
                <div class="case-grid">
                    {cases.map((item, index) => (
                        <details class={`tile case-card ${item.color}`}>
                            <summary><span class="case-top"><span class="case-label">{item.label}</span><span class="case-index">0{index + 1}</span></span><strong class="case-value">{item.value}</strong><h3>{item.title}</h3><span class="case-open">Подробнее <span aria-hidden="true">＋</span></span></summary>
                            <div class="case-details"><dl><dt>Задача</dt><dd>{item.problem}</dd><dt>Что сделал</dt><dd>{item.action}</dd><dt>Результат</dt><dd>{item.result}</dd></dl></div>
                        </details>
                    ))}
                </div>
                <a class="text-link" href={resume} target="_blank" rel="noopener noreferrer" data-goal="resume">Больше об опыте — в резюме</a>

                <figure class="featured-project">
                    <div class="project-demo">
                        <video
                            playsinline
                            muted
                            loop
                            preload="none"
                            width="1092"
                            height="982"
                            poster="/projects/vtb-online-preview.webp"
                            aria-label="Демонстрация раздела «Выгода» в ВТБ Онлайн"
                            src="/projects/vtb-online.mp4"
                        ></video>
                        <button class="demo-toggle" type="button" aria-label="Воспроизвести видео" hidden></button>
                    </div>
                    <figcaption class="featured-project-caption">
                        <span class="card-kicker">Текущий рабочий проект</span>
                        <h3>Программа лояльности ВТБ</h3>
                        <p>Руковожу фронтендом программы лояльности и командой до 12 человек. Вместе развиваем раздел «Выгода» в веб-версии ВТБ Онлайн. Я отвечаю за архитектуру, найм и развитие разработчиков.</p>
                        <div class="featured-project-actions">
                            <a class="button button-primary" href="/projects/">Все рабочие проекты</a>
                            <a class="button button-secondary" href="/projects/#vtb">Открыть кейс ВТБ</a>
                        </div>
                    </figcaption>
                </figure>
            </section>

            <section class="home-section" id="projects">
                <div class="section-heading"><div><p class="section-index">03 / Сайд-проекты</p><h2>Мои проекты</h2><p>Сайд-проекты, в которых проверяю идеи на практике.</p></div></div>
                <div class="project-grid">
                    <a class="tile project-card project-clicker" href="/tools/clicker/"><span class="project-art" aria-hidden="true">⌖</span><span class="project-type">Веб · эксперимент</span><h3>Clicker</h3><p>Счётчик кликов с историей. Эксперимент с обратной связью и простым интерфейсом.</p><span class="project-action">Открыть проект</span></a>
                    <a class="tile project-card project-breeze" href="/tools/breeze/"><span class="project-art" aria-hidden="true">≈</span><span class="project-type">Веб · инструмент</span><h3>Breeze</h3><p>Небольшой инструмент для концентрации и спокойной работы.</p><span class="project-action">Открыть проект</span></a>
                    <a class="tile project-card project-vacation" href="/tools/vacation-2027/"><span class="project-art" aria-hidden="true">▦</span><span class="project-type">Веб · инструмент</span><h3>Калькулятор отпуска на 2027 год</h3><p>Подбирает даты отпуска с учётом выходных и праздников и сравнивает зарплату с отпускными.</p><span class="project-action">Открыть калькулятор</span></a>
                </div>
            </section>

            <div class="lower-grid">
                <section class="tile consulting" id="consulting">
                    <HeroIntro tone="warm" />
                    <p class="section-index">04 / Консультации</p><h2>Помогу разобраться с технической задачей.</h2><p>Архитектура и технические решения, развитие команды, AI в продукте и разработке. Расскажите о задаче — вместе определим подходящий формат.</p><ul><li>Разбор конкретной ситуации</li><li>Аудит и рекомендации</li><li>Сопровождение изменений</li></ul><a class="button button-lime" href={telegram} target="_blank" rel="noopener noreferrer" data-goal="telegram"><TelegramIcon /> Написать о задаче</a><small>Формат и стоимость обсуждаем индивидуально.</small></section>
                <section class="blog-section" id="blog">
                    <div class="section-heading">
                        <div>
                            <p class="section-index">05 / Пишу о практике</p>
                            <h2>Блог</h2>
                            <p>Заметки о разработке и управлении командой.</p>
                        </div>
                    </div>
                    <div class="post-grid">
                        {posts.map((post) => (
                            <a class="tile post-card" href={`/blog/${post.id}/`}>
                                <span class="post-label">{post.id === 'sobesedovanie-na-timlida' ? 'УПРАВЛЕНИЕ' : 'ТЕХНОЛОГИИ'}</span>
                                <h3>{post.data.title}</h3>
                                <p>{post.data.description}</p>
                            </a>
                        ))}
                    </div>
                    <a class="button button-secondary blog-all" href="/blog/">Все статьи</a>
                </section>
            </div>
            <section class="closing" aria-label="Связаться"><span class="section-index">На связи</span><h2>Открыт к предложениям и новым проектам. Напишите, если мой опыт может быть полезен.</h2><div class="closing-actions"><a class="button button-primary" href={telegram} target="_blank" rel="noopener noreferrer" data-goal="telegram"><TelegramIcon /> Написать в Telegram</a><a class="button button-dark-outline" href={resume} target="_blank" rel="noopener noreferrer" data-goal="resume">Резюме на HH</a><a class="button button-dark-outline" href="https://github.com/StipJey" target="_blank" rel="noopener noreferrer">GitHub</a></div><div class="closing-meta"><span>Евгений Черкасов</span><span>Санкт-Петербург · Удалённо</span></div></section>
        </main>
        <Footer compact />
        <script>
            const demo = document.querySelector<HTMLVideoElement>('.project-demo video');
            const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

            const demoToggle = document.querySelector<HTMLButtonElement>('.demo-toggle');

            if (demo && demoToggle) {
                const syncDemoToggle = () => {
                    demoToggle.setAttribute(
                        'aria-label',
                        demo.paused ? 'Воспроизвести видео' : 'Приостановить видео',
                    );
                    demoToggle.dataset.paused = String(demo.paused);
                };
                const playDemo = () => {
                    void demo.play().catch(syncDemoToggle);
                };

                syncDemoToggle();
                demoToggle.hidden = false;
                demo.addEventListener('play', syncDemoToggle);
                demo.addEventListener('pause', syncDemoToggle);
                demoToggle.addEventListener('click', () => {
                    if (demo.paused) playDemo();
                    else demo.pause();
                });

                if (!motion.matches && 'IntersectionObserver' in window) {
                    const observer = new IntersectionObserver(([entry]) => {
                        if (entry.intersectionRatio < 0.5) return;
                        observer.disconnect();
                        if (!motion.matches) playDemo();
                    }, { threshold: 0.5 });
                    observer.observe(demo);
                    demo.addEventListener('play', () => observer.disconnect(), { once: true });
                }
            }

            const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
            menu?.addEventListener('click', (event) => {
                if (event.target instanceof Element && event.target.closest('a')) {
                    menu.open = false;
                }
            });
            menu?.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && menu.open) {
                    menu.open = false;
                    menu.querySelector('summary')?.focus();
                }
            });

            const pointer = window.matchMedia('(hover: hover) and (pointer: fine)');
            for (const link of document.querySelectorAll<HTMLElement>('.home .button, .home-page .contact-link')) {
                link.classList.add('magnetic-button');
                link.addEventListener('pointermove', (event) => {
                    if (!pointer.matches || motion.matches || event.pointerType !== 'mouse') return;
                    const bounds = link.getBoundingClientRect();
                    const x = (event.clientX - bounds.left - bounds.width / 2) * 0.16;
                    const y = (event.clientY - bounds.top - bounds.height / 2) * 0.35;
                    link.style.setProperty('--magnet-x', `${Math.max(-12, Math.min(12, x))}px`);
                    link.style.setProperty('--magnet-y', `${y}px`);
                });

                const reset = () => {
                    link.style.removeProperty('--magnet-x');
                    link.style.removeProperty('--magnet-y');
                };
                link.addEventListener('pointerleave', reset);
                link.addEventListener('blur', reset);
                motion.addEventListener('change', reset);
            }

            const multiColumnCards = window.matchMedia('(min-width: 851px)');
            const expandableGrids = document.querySelectorAll(
                '.service-grid, .case-grid',
            );

            for (const grid of expandableGrids) {
                grid.addEventListener('click', (event) => {
                    if (!(event.target instanceof Element)) return;

                    const summary = event.target.closest('summary');
                    const selectedCard = summary?.parentElement;
                    if (
                        !multiColumnCards.matches ||
                        !(selectedCard instanceof HTMLDetailsElement) ||
                        !grid.contains(selectedCard)
                    ) {
                        return;
                    }

                    event.preventDefault();
                    const shouldOpen = !selectedCard.open;
                    grid.querySelectorAll('details').forEach((card) => {
                        card.open = shouldOpen;
                    });
                });
            }

            multiColumnCards.addEventListener('change', (event) => {
                if (!event.matches) return;

                for (const grid of expandableGrids) {
                    const shouldOpen = Array.from(grid.querySelectorAll('details')).some(
                        (card) => card.open,
                    );
                    grid.querySelectorAll('details').forEach((card) => {
                        card.open = shouldOpen;
                    });
                }
            });

        </script>
    </body>
</html>
