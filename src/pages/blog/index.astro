---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="ru">
    <head>
        <BaseHead
            title="Статьи | Евгений Черкасов"
            description="Статьи Евгения Черкасова о фронтенде, архитектуре и управлении разработкой."
        />
        <style>
            .archive {
                max-width: 940px;
            }

            .eyebrow {
                margin: 0 0 0.75rem;
                color: var(--brand);
                font-size: 0.82rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            .intro {
                max-width: 680px;
                margin-bottom: 2.5rem;
                color: var(--text-muted);
            }

            .archive h1 {
                margin: 0 0 0.6rem;
            }

            .post-list {
                display: grid;
                gap: 1rem;
                margin: 0;
                padding: 0;
                list-style: none;
            }

            .post-link {
                display: block;
                padding: clamp(1.25rem, 3vw, 1.75rem);
                border: 1px solid var(--line);
                border-radius: 22px;
                background: var(--surface);
                color: var(--text-primary);
                text-decoration: none;
                transition: border-color 180ms ease, transform 180ms ease;
            }

            .post-link:hover,
            .post-link:focus-visible {
                border-color: var(--brand);
                transform: translateY(-2px);
            }

            .post-link h2 {
                margin: 0 0 0.5rem;
                font-size: clamp(1.15rem, 2vw, 1.45rem);
            }

            .post-link p {
                margin: 0;
                color: var(--text-muted);
            }

            .post-link time {
                display: block;
                margin-bottom: 0.65rem;
                color: var(--text-muted);
                font-size: 0.85rem;
            }

            @media (prefers-reduced-motion: reduce) {
                .post-link {
                    transition: none;
                }

                .post-link:hover,
                .post-link:focus-visible {
                    transform: none;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main class="archive">
            <p class="eyebrow">Блог</p>
            <h1>Статьи из практики</h1>
            <p class="intro">
                Пишу о разработке, архитектуре и работе с командами — с примерами
                из реальных задач.
            </p>
            <ul class="post-list">
                {
                    posts.map((post) => (
                        <li>
                            <a class="post-link" href={`/blog/${post.id}/`}>
                                <FormattedDate date={post.data.pubDate} />
                                <h2>{post.data.title}</h2>
                                <p>{post.data.description}</p>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </main>
        <Footer />
    </body>
</html>
