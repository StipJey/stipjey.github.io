function monthModel(selection = selectedSet(), bonuses = makeBonusPlan()) {
    const periods = segmentsForSet(selection);
    const startsByMonth = Array.from({ length: 12 }, () => []);
    const dailyPay = new Map();
    for (const part of periods) startsByMonth[part.items[0].m].push(part);

    const previous = Array.from({ length: 12 }, () => ({
        base: s.salary + s.history, den: 29.3,
    }));
    const months = [];
    let cumBefore = 0;
    let cumWith = 0;
    let bonusTotal = 0;
    for (let m = 0; m < 12; m++) {
        const b = bonuses[m].reduce((sum, item) => sum + item.amount, 0);
        bonusTotal += b;
        const chosen = monthDays[m].filter((day) => selection.has(day.key));
        const chosenWork = chosen.filter((day) => day.work).length;
        const baseSalary = s.salary * (1 - chosenWork / workCounts[m]);
        const rolling = previous.slice(-12);
        const den = rolling.reduce((sum, month) => sum + month.den, 0);
        const average = den > 0
            ? rolling.reduce((sum, month) => sum + month.base, 0) / den
            : s.salary / 29.3;
        // Одна ставка на всю часть отпуска, даже если она переходит на следующий месяц.
        for (const part of startsByMonth[m]) {
            for (const day of part.items) dailyPay.set(day.key, average);
        }
        const vacationPay = chosen.reduce((sum, day) => sum + dailyPay.get(day.key), 0);
        const withGross = baseSalary + b + vacationPay;
        const baseline = s.salary + b;
        const taxBefore = tax(cumBefore + baseline) - tax(cumBefore);
        const taxWith = tax(cumWith + withGross) - tax(cumWith);
        cumBefore += baseline;
        cumWith += withGross;
        months.push({
            m, work: workCounts[m], off: restCounts[m], selected: chosen.length,
            chosenWork, bonus: b, bonusEntries: bonuses[m], salary: baseSalary,
            baseSalary: s.salary, average, vacationPay, baseline, withGross,
            baselineNet: baseline - taxBefore, net: withGross - taxWith, taxWith,
            taxBefore, workday: s.salary / workCounts[m],
        });
        previous.push({
            base: baseSalary + b,
            den: 29.3 * (numdays(m) - chosen.length) / numdays(m),
        });
    }
    const grossYear = s.salary * 12 + bonusTotal;
    const baseNet = grossYear - tax(grossYear);
    const withYear = months.reduce((sum, month) => sum + month.withGross, 0);
    const withNet = months.reduce((sum, month) => sum + month.net, 0);
    return {
        months, grossYear, bonusTotal, baseNet, withYear, withNet,
        difference: withNet - baseNet, periods, runs: periodRestRuns(selection),
        selected: selection, dailyPay,
    };
}
