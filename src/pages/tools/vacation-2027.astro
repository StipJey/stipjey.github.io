function planChanged(recheckAuto = false) {
    invalidateComparison();
    resetPlanSearch();
    plannerError = '';
    plannerNotice = '';
    if (recheckAuto) {
        const previous = s.auto.length;
        s.auto = planner.retainedAuto(s);
        const removed = previous - s.auto.length;
        if (removed) {
            plannerNotice = `Убрано ${removed} автодн., которые больше не подходят под условия.`;
        }
    }
    scheduleRender();
}

const numericLimits = {
    salary: [0, 1e9], budget: [0, 120], history: [0, 1e8],
    minGap: [0, 365], maxRestDays: [1, 365], minPart: [1, 120],
    minParts: [1, 20], maxParts: [1, 20], minWeekendDays: [0, 14],
};

const ruleControlIds = [
    ...Object.keys(numericLimits), 'gapUnit', 'workYearStart', 'weekendPolicy', 'weekendRule',
];

function updateRule(id) {
    const control = el(id);
    control.addEventListener('change', () => {
        let value = control.value;
        const bounds = numericLimits[id];
        if (bounds && value !== '' && Number.isFinite(Number(value))) {
            value = Math.max(bounds[0], Math.min(bounds[1], Number(value)));
            if (id !== 'salary' && id !== 'history') value = Math.trunc(value);
        } else if (bounds || (id === 'workYearStart' && !validWorkYearStart(value))) {
            control.value = s[id];
            if (id === 'workYearStart') toast('Укажите дату начала рабочего года.');
            return;
        }
        control.value = value;
        if (s[id] === value) return;
        s[id] = value;
        if (id === 'minPart') s.minPartConfigured = true;
        if (id === 'minGap' || id === 'gapUnit') s.gapConfigured = true;
        if (id === 'minParts' && s.minParts > s.maxParts) {
            s.maxParts = s.minParts;
            el('maxParts').value = s.maxParts;
        }
        if (id === 'maxParts' && s.maxParts < s.minParts) {
            s.minParts = s.maxParts;
            el('minParts').value = s.minParts;
        }
        if (id === 'weekendRule') renderWeekendControls();
        planChanged(id !== 'salary' && id !== 'history');
    });
}

for (const id of ruleControlIds) updateRule(id);

