    toast('Отпускные даты очищены');
});
function downloadFile(name,type,content){let blob=new Blob([content],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);}
const icsDate=key=>key.replaceAll('-','');function nextDate(key){let d=new Date(key+'T00:00:00Z');d.setUTCDate(d.getUTCDate()+1);return `${d.getUTCFullYear()}-${pad(d.getUTCMonth()+1)}-${pad(d.getUTCDate())}`;}
el('ics').addEventListener('click',()=>{if(!data.periods.length){toast('Сначала выберите дни отпуска');return;}let lines=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Vacation Planner 2027//RU','CALSCALE:GREGORIAN'];for(let [i,p] of data.periods.entries()){lines.push('BEGIN:VEVENT','UID:vacation2027-'+i+'-'+icsDate(p.start)+'@offline','DTSTAMP:20261108T000000Z','DTSTART;VALUE=DATE:'+icsDate(p.start),'DTEND;VALUE=DATE:'+icsDate(nextDate(p.end)),'SUMMARY:Отпуск','DESCRIPTION:Ежегодный оплачиваемый отпуск. '+p.items.length+' дней.','END:VEVENT');}lines.push('END:VCALENDAR');downloadFile('otpusk-2027.ics','text/calendar;charset=utf-8',lines.join('\r\n'));});
el('csv').addEventListener('click',()=>{let rows=[['Месяц','Рабочих','Выходных','Отпускных дней','Оклад гросс','Премии гросс','Отпускные гросс','Начислено гросс','НДФЛ','На руки']];for(const m of data.months)rows.push([MONTHS[m.m],m.work,m.off,m.selected,Math.round(m.salary),Math.round(m.bonus),Math.round(m.vacationPay),Math.round(m.withGross),Math.round(m.taxWith),Math.round(m.net)]);downloadFile('otpusk-2027.csv','text/csv;charset=utf-8','\ufeff'+rows.map(row=>row.join(';')).join('\r\n'));});
el('print').addEventListener('click',()=>window.print());
const summaryText=()=>`План отпуска — 2027\nОклад: ${fmtMoney(s.salary)} / мес.\nПремии за 2027: ${fmtMoney(data.bonusTotal)}\nГод без отпуска: ${fmtMoney(data.grossYear)} гросс / ${fmtMoney(data.baseNet)} на руки\nС отпуском: ${fmtMoney(data.withYear)} гросс / ${fmtMoney(data.withNet)} на руки\nРазница: ${fmtMoney(data.difference)}\nДней отпуска: ${data.selected.size} из ${s.budget}\n${data.runs.map(run=>`${humanDate(run.start)} — ${humanDate(run.end)} (${run.leaves} отпускных дн., ${run.len} дней отдыха)`).join('\n')}`;
function copy(text){if(navigator.clipboard?.writeText)return navigator.clipboard.writeText(text).then(()=>true).catch(()=>fallbackCopy(text));return Promise.resolve(fallbackCopy(text));}function fallbackCopy(text){let a=document.createElement('textarea');a.value=text;document.body.append(a);a.select();let success=document.execCommand('copy');a.remove();return success;}
el('copySummary').addEventListener('click',async()=>{let ok=await copy(summaryText());toast(ok?'Итоги скопированы':'Не удалось скопировать, выделите текст вручную');});
el('share').addEventListener('click',async()=>{let obj={...s};let json=JSON.stringify(obj),hash='#plan='+btoa(unescape(encodeURIComponent(json))),url=location.origin+location.pathname+hash;if(location.protocol==='file:'){toast('Для ссылки разместите HTML на сайте. Сейчас открыт локальный файл.');return;}if(url.length>7000){toast('План слишком большой для удобной ссылки. Используйте CSV или .ics.');return;}let ok=await copy(url);toast(ok?'Ссылка на план скопирована. Она содержит информацию о зарплате!':'Не удалось скопировать ссылку');});
setControls();renderBonusRules();renderRestrictions();
const { days: initialFourDayDays, from, to } = fourDayDraft || defaultFourDay;
const fourDayMonths = MONTHS.map((month, index) => [index + 1, month]);
const fourDayFormValue = () => normalizeFourDay({
    days: [...el('fourDayWeekdays').querySelectorAll('input:checked')].map((input) => input.value),
    from: Number(el('fourDayFrom').value),
    to: Number(el('fourDayTo').value),
});
for (const input of el('fourDayWeekdays').querySelectorAll('input')) {
    input.checked = initialFourDayDays.includes(input.value);
    input.addEventListener('change', () => {
        fourDayDraft = fourDayFormValue();
        scheduleRender();
    });
}
el('fourDayFrom').innerHTML = makeSelect(fourDayMonths, from);
el('fourDayTo').innerHTML = makeSelect(fourDayMonths, to);
for (const id of ['fourDayFrom', 'fourDayTo']) {
    el(id).addEventListener('change', () => {
        fourDayDraft = fourDayFormValue();
        scheduleRender();
    });
}
el('vacationFourDay').open = Boolean(fourDayDraft) || location.hash === '#vacationFourDay';
el('fourDayExample').hidden = !inFourDayExample;
if (inFourDayExample) {
    setText('storageHelp', 'Изменения в примере действуют до перезагрузки страницы.');
}
if (inExample) {
    setText('exampleTitle', showExampleComparison ? 'Сравнение отпусков по доходу' : `Отпуск ${examplePlan.title}`);
    setText('exampleIntro', showExampleComparison
        ? 'Суммы до НДФЛ по текущим настройкам. Откройте даты в таблице, чтобы посмотреть отдельный вариант в календаре.'
        : 'Суммы до НДФЛ по выбранным датам. Изменения в примере действуют до перезагрузки страницы.');
    setText('storageHelp', 'Изменения в примере действуют до перезагрузки страницы.');
    el('vacationExample').hidden = false;
    if (examplePlan) el('periodList').open = true;
}
const savedAutoCount = s.auto.length;
s.auto = planner.retainedAuto(s);
if (s.auto.length < savedAutoCount) {
    plannerNotice = `Из сохранённого плана убрано ${savedAutoCount - s.auto.length} автодн., нарушавших ограничения.`;
}
renderAll();
})();
</script>
    </body>
</html>
