const styleLabels = {
    rest: 'Максимум отдыха',
    money: 'Больше денег',
    balanced: 'Сбалансированный',
};

function planningInput() {
    const error = planner.manualProblem(s);
    if (error) return { error };
    const manual = new Set(s.manual);
    const options = planner.solverOptions(s, segmentsForSet(manual));
    const bonuses = makeBonusPlan();
    const baseline = monthModel(manual, bonuses);
    const unit = Math.max(1, (s.salary + s.history) / 29.3, ...baseline.months.map((m) => m.average));
    const summerWeights = [-1.7, -1.4, -.3, .1, .9, 3.3, 4.3, 4.3, 1.3, .2, -.7, -1.2];
    const candidates = planner.candidatesFor(s).map((candidate) => {
        let estimatedNet = 0;
        let preference = 0;
        for (const part of candidate.parts) {
            const rate = baseline.months[part.items[0].m].average;
            for (const day of part.items) {
                estimatedNet += rate - (day.work ? s.salary / workCounts[day.m] : 0);
                if (s.preferredMonths.includes(day.m)) preference += 1.8;
                if (s.avoidedMonths.includes(day.m)) preference -= 1.8;
                if (s.preference === 'summer') preference += summerWeights[day.m] / 10;
            }
            if (s.weekendPolicy === 'discourage' && part.items.every((day) => day.work)) {
                preference -= Math.max(.1, part.items.length * .03);
            }
        }
        if (s.preference === 'holidays') {
            const rest = days.slice(candidate.restStartIndex, candidate.restEndIndex + 1);
            preference += rest.filter((day) => day.holiday || day.isTransferredDayOff).length * 1.25;
        }
        return { ...candidate, estimatedNet: estimatedNet / unit, preference };
    });
    return { manual, options, candidates, bonuses };
}

function spreadScore(plan) {
    const totalParts = plan.reduce((sum, candidate) => sum + candidate.partCount, 0);
    let parts = 0;
    return plan.reduce((score, candidate) => {
        parts += candidate.partCount;
        const position = (candidate.centerIndex + .5) / days.length;
        return score - (position - (parts - .5) / totalParts) ** 2;
    }, 0);
}

function keysFor(plan) {
    return plan.flatMap((candidate) => candidate.leaveKeys).sort();
}

function improveMoneyPlan(input, initialPlans, excludedSelections) {
    const { candidates, options, bonuses, manual } = input;
    const evaluate = (plan) => {
        const model = monthModel(new Set([...manual, ...keysFor(plan)]), bonuses);
        const preference = plan.reduce((sum, candidate) => sum + candidate.preference, 0);
        return {
            net: model.withNet,
            preference: s.preference === 'spread' ? spreadScore(plan) : preference,
        };
    };
    const better = (score, best) => score.net > best.net + .005 ||
        (Math.abs(score.net - best.net) <= .005 && score.preference > best.preference);
    let best = initialPlans[0];
    let bestScore = evaluate(best);
    const used = keysFor(best).length;
    for (const plan of initialPlans.slice(1)) {
        const keys = keysFor(plan);
        if (keys.length !== used || excludedSelections.has(keys.join(','))) continue;
        const score = evaluate(plan);
        if (better(score, bestScore)) {
            best = plan;
            bestScore = score;
        }
    }

    // Пересчитываем доход по полной модели для замен отдельных периодов.
    // Число частей и расход бюджета при такой замене сохраняются.
    for (let pass = 0; pass < 2; pass++) {
        const current = best;
        for (const replaced of current) {
            const others = current.filter((candidate) => candidate !== replaced);
            const needs14 = options.requires14 && !options.hasCompleted14DayPart &&
                !others.some((candidate) => candidate.has14DayPart);
            for (const candidate of candidates) {
                if (candidate.cost !== replaced.cost || candidate.partCount !== replaced.partCount ||
                    (needs14 && !candidate.has14DayPart)) continue;
                if (!others.every((other) => planner.compatible(candidate, other, s))) continue;
                const plan = [...others, candidate].sort((a, b) => a.restStartIndex - b.restStartIndex);
                if (excludedSelections.size && excludedSelections.has(keysFor(plan).join(','))) continue;
                const score = evaluate(plan);
                if (better(score, bestScore)) {
                    best = plan;
                    bestScore = score;
                }
            }
        }
        if (best === current) break;
    }
    return best;
}

function scoreAndSolve(style, candidates, options) {
    const scored = candidates.map((candidate) => {
        const rest = candidate.restLength;
        const money = candidate.estimatedNet;
        const preference = candidate.preference;
        const score = style === 'money' ? money + .06 * preference
            : style === 'rest' ? rest + rest ** 1.16 * .25 + preference
            : rest * .45 + rest ** 1.12 * .15 + money * .85 + preference;
        return { ...candidate, score, priority: style === 'rest' ? rest : 0 };
    });
    return optimizeIntervals(scored, options);
}

function solvePresets(styles, excludedPlans = []) {
    const input = planningInput();
    const results = new Map();
    if (input.error) {
        for (const style of styles) results.set(style, { error: input.error });
        return results;
    }
    const spread = s.preference === 'spread';
    const options = {
        ...input.options,
        excludedPlans,
        yearLength: spread ? days.length : undefined,
        spreadWeight: spread ? 16 : 0,
    };
    const excludedSelections = new Set(excludedPlans.map((plan) => keysFor(plan).join(',')));
    const unrestrictedPlans = new Map();
    function solveUnrestricted(style) {
        if (!unrestrictedPlans.has(style)) {
            unrestrictedPlans.set(style, scoreAndSolve(style, input.candidates, options));
        }
        return unrestrictedPlans.get(style);
    }
    for (const style of styles) {
        const workdaysOnly = style === 'rest';
        const needs14 = options.requires14 && !options.hasCompleted14DayPart;
        const notice = '';
        const settings = s;
        const styleOptions = workdaysOnly && needs14
            ? { ...options, minimizeOffDays: true }
            : options;
        const candidates = workdaysOnly
            ? input.candidates.filter((candidate) => {
                  const mandatoryPart = needs14
                      ? candidate.parts.find((part) => planner.has14([part], s))
                      : null;
                  return candidate.parts.every((part) => {
                      if (part.items.every((day) => day.work)) return true;
                      return part === mandatoryPart &&
                          part.items.length >= 14 &&
                          part.items.filter((day) => day.off).length <= 4;
                  });
              }).map((candidate) => ({
                  ...candidate,
                  offDays: candidate.parts
                      .reduce((sum, part) => sum + part.items.filter((day) => day.off).length, 0),
              }))
            : input.candidates;

        let error = '';
        if (styleOptions.budget < 0 || styleOptions.maxParts < 0) {
            error = 'Для обязательной части нужно оставить 14 дней и одну часть. Добавьте её вручную или увеличьте бюджет и число частей.';
        } else if (styleOptions.minParts > 0 && styleOptions.budget < s.minPart) {
            error = 'Оставшихся отпускных дней меньше минимума в части. Увеличьте бюджет или уменьшите минимум.';
        } else if (workdaysOnly && needs14 &&
            !candidates.some((candidate) => candidate.has14DayPart)) {
            error = 'Не найден обязательный период из 14 отпускных дней с максимум четырьмя выходными. Проверьте исключённые даты, месяцы и промежутки до ручных периодов.';
        } else if (!workdaysOnly && needs14 &&
            !candidates.some((candidate) => candidate.has14DayPart)) {
            error = 'Не найдено места для 14 отпускных дней подряд в заданном рабочем году. Проверьте бюджет, исключённые даты и промежутки до ручных периодов.';
        }
        if (error) {
            results.set(style, { error });
            continue;
        }

        const solved = workdaysOnly
            ? scoreAndSolve(style, candidates, styleOptions)
            : solveUnrestricted(style);
        if (solved.status !== 'optimal') {
            results.set(style, {
                error: 'Допустимый план не найден. Попробуйте увеличить доступное окно, уменьшить минимум дней в части или изменить число частей.',
            });
            continue;
        }
        let plan = solved.plan;
        if (style === 'money') {
            const otherSeeds = ['rest', 'balanced']
                .map(solveUnrestricted)
                .filter((result) => result.status === 'optimal')
                .map((result) => result.plan);
            plan = improveMoneyPlan(input, [plan, ...otherSeeds], excludedSelections);
        }
        const selected = keysFor(plan);
        error = planner.validate(settings, selected);
        results.set(style, error ? { error } : { selected, plan, notice });
    }
    return results;
}

function applyPlan({ selected, notice }, style) {
    s.auto = selected;
    plannerError = '';
    plannerNotice = selected.length
        ? `«${styleLabels[style]}». Подобрано ${selected.length} дн.`
        : 'Автоматические даты не добавлены. Ручные даты сохранены.';
    if (notice) plannerNotice = selected.length ? `${plannerNotice} ${notice}` : notice;
    scheduleRender();
    toast(plannerNotice);
}

function resetPlanSearch() {
    planSearch = null;
    el('nextPlanControls').hidden = true;
    el('nextPlan').disabled = false;
    setText('nextPlanStatus', '');
}

function startPlanSearch(solved, style) {
    resetPlanSearch();
    applyPlan(solved, style);
    if (!solved.selected.length) return;
    planSearch = { style, used: solved.selected.length, shown: [solved.plan] };
    el('nextPlanControls').hidden = false;
}

let calculationInProgress = false;
async function runWithCalculationSpinner(calculate) {
    if (calculationInProgress) return;
    calculationInProgress = true;
    const panel = el('vacationPresets');
    const status = el('calculationStatus');
    const controls = [...panel.querySelectorAll(
        '[data-preset], #compareAlternatives, #nextPlan',
    )];
    const disabled = controls.map((control) => control.disabled);
    let restoreDisabled = disabled;
    const shownAt = performance.now();
    panel.setAttribute('aria-busy', 'true');
    status.hidden = false;
    controls.forEach((control) => { control.disabled = true; });
    try {
        // Let the browser paint the status before the synchronous search starts.
        await new Promise((resolve) => window.setTimeout(resolve, 40));
        controls.forEach((control, index) => { control.disabled = disabled[index]; });
        calculate();
        for (const control of panel.querySelectorAll('[data-alternative]')) {
            if (controls.includes(control)) continue;
            controls.push(control);
            disabled.push(control.disabled);
        }
        restoreDisabled = controls.map((control) => control.disabled);
        controls.forEach((control) => { control.disabled = true; });
        const remaining = 180 - (performance.now() - shownAt);
        if (remaining > 0) {
            await new Promise((resolve) => window.setTimeout(resolve, remaining));
        }
    } finally {
        controls.forEach((control, index) => {
            control.disabled = restoreDisabled[index] ?? disabled[index];
        });
        status.hidden = true;
        panel.setAttribute('aria-busy', 'false');
        calculationInProgress = false;
    }
}

function optimize(style) {
    const solved = solvePresets([style]).get(style);
    if (!solved.error) {
        startPlanSearch(solved, style);
        return;
    }
    resetPlanSearch();
    s.auto = [];
    plannerNotice = '';
    plannerError = solved.error;
    toast(plannerError);
    scheduleRender();
}

el('nextPlan').addEventListener('click', () => runWithCalculationSpinner(() => {
    if (!planSearch) return;
    const { style, used, shown } = planSearch;
    const solved = solvePresets([style], shown).get(style);
    if (solved.error || solved.selected.length !== used) {
        setText('nextPlanStatus', 'Других вариантов с таким же числом отпускных дней не найдено.');
        el('nextPlan').disabled = true;
        return;
    }
    shown.push(solved.plan);
    applyPlan(solved, style);
    setText('nextPlanStatus', `Показан вариант № ${shown.length}.`);
}));

function showAlternativePlans() {
    alternativePlans = solvePresets(Object.keys(styleLabels));
    el('alternativePlans').innerHTML = [...alternativePlans].map(([style, solved]) => {
        const title = styleLabels[style];
        if (solved.error) {
            return `<div class="alternative-card"><strong>${title}</strong><small>${escapeAttr(solved.error)}</small></div>`;
        }
        const keys = [...s.manual, ...solved.selected];
        const model = monthModel(new Set(keys));
        const restDays = model.runs.reduce((sum, run) => sum + run.len, 0);
        const remaining = Math.max(0, s.budget - keys.length);
        const dates = (intervals) => intervals.map(({ start, end }) =>
            start === end ? humanDate(start) : `${humanDate(start)} — ${humanDate(end)}`,
        ).join(' · ');
        return `<article class="alternative-card">
            <strong>${title}</strong>
            <span>${keys.length} из ${s.budget} отпускных дн. · ${restDays} дн. отдыха · остаток ${remaining}</span>
            <small>Отпуск: ${dates(model.periods) || 'даты не выбраны'}</small>
            <small>Отдых: ${dates(model.runs) || 'даты не выбраны'}</small>
            <small>На руки за год: ${fmtMoney(model.withNet)} · разница: ${model.difference >= 0 ? '+' : '−'}${fmtMoney(Math.abs(model.difference))}</small>
            ${solved.notice ? `<small>${escapeAttr(solved.notice)}</small>` : ''}
            <button type="button" class="small-btn" data-alternative="${style}" aria-label="Применить вариант «${title}»">Применить</button>
        </article>`;
    }).join('');
}

