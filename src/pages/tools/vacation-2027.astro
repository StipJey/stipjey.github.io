function selectManual(keys) {
    const manual = [...new Set([...s.manual, ...keys])];
    const auto = s.auto.filter((key) => !keys.includes(key));
    if (manual.length + auto.length > s.budget) {
        toast(`Ручной выбор займёт ${manual.length + auto.length} дн. при бюджете ${s.budget}.`);
        return false;
    }
    const additions = new Set(keys);
    s.manual = manual;
    s.auto = auto;
    s.avoided = s.avoided.filter((key) => !additions.has(key));
    planChanged(true);
    return true;
}

function toggleDay(key, force) {
    const day = byKey.get(key);
    if (!day) return;
    if (day.holiday) {
        toast(`Это праздник: ${day.label}. Он не расходует отпускные дни.`);
        return;
    }
    const current = status(key);
    if (force ?? !current) {
        selectManual([key]);
    } else {
        s.manual = s.manual.filter((item) => item !== key);
        s.auto = s.auto.filter((item) => item !== key);
        if (current === 'auto' && !s.avoided.includes(key)) {
            s.avoided.push(key);
        }
        planChanged(true);
    }
}

