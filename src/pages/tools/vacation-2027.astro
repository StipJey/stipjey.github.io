function showFourDayResult(message, warn = false) {
    const result = el('fourDayResult');
    if (result.textContent !== message) result.textContent = message;
    result.classList.toggle('warn', warn);
}

function renderFourDay() {
    const result = fourDayResult;
    const hasDates = Boolean(result?.required);
    el('fourDayLinks').hidden = !hasDates;
    if (!result) {
        showFourDayResult('');
        return;
    }
    const { from, to } = fourDayDraft;
    const range = from === to
        ? MONTHS[from - 1]
        : `${MONTHS[from - 1]}–${MONTHS[to - 1].toLowerCase()}`;
    const existing = result.existing.length;
    const messages = [`${range}. Отпускных дней по графику: ${result.required}.`];
    if (existing) messages.push(`Из них уже выбрано вручную: ${existing}.`);
    if (result.excluded) messages.push(`Нерабочих дат пропущено: ${result.excluded}.`);
    if (s.auto.length) messages.push('При применении автодаты будут сброшены.');
    if (!result.fits) {
        messages.push(`В бюджет поместятся первые ${result.appliedDates.length} дн. по графику. Прежний ручной план будет заменён.`);
    } else if (result.needsManualReset) {
        messages.push('Текущий ручной план будет заменён графиком, чтобы он поместился в бюджет.');
    }
    if (hasDates) {
        const current = data;
        const preview = monthModel(new Set(result.manualAfter));
        const periodNet = (model) => model.months.slice(from - 1, to)
            .reduce((sum, month) => sum + month.net, 0);
        const net = periodNet(preview);
        const formatChange = (value) => {
            const rounded = Math.round(value);
            const sign = rounded > 0 ? '+' : rounded < 0 ? '−' : '';
            return sign + fmtMoney(Math.abs(rounded));
        };
        const periodChange = formatChange(net - periodNet(current));
        const yearChange = formatChange(preview.withNet - current.withNet);
        messages.push(
            `Если применить даты вручную, на руки за этот период ${fmtMoney(net)}. ` +
            `По сравнению с текущим планом за период ${periodChange}, за год ${yearChange}.`,
        );
    }
    messages.push('Нажмите «Применить как ручные даты», чтобы отметить их в календаре.');
    showFourDayResult(messages.join(' '), !result.fits);
}

